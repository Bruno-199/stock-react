# Configuración avanzada de conexión
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

# ======================================
# BASE DE DATOS LOCAL (DESARROLLO)
# ======================================
# Todas estas variables son REQUERIDAS para desarrollo
LOCAL_DB_HOST=localhost
LOCAL_DB_USER=tu-usuario-local
LOCAL_DB_PASSWORD=tu-password-local
LOCAL_DB_NAME=stock
LOCAL_DB_CONNECTION_LIMIT=5

# ======================================
# CORS Y SEGURIDAD
# ======================================
# URLs permitidas (separadas por comas)
CORS_ORIGIN=http://localhost:3000,https://tu-frontend.onrender.com,http://localhost:3000

# ======================================
# NOTAS IMPORTANTES
# ======================================
# 1. Para DESARROLLO: usa las variables LOCAL_DB_*
# 2. Para PRODUCCIÓN: usa las variables DATABASE_* (Clever Cloud)
# 3. En Render Dashboard, configura las variables DATABASE_*
# 4. El archivo .env real no se sube a GitHub (.gitignore)
# 5. Tu base de datos de Clever Cloud ya tiene datos de ejemplo
