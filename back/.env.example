# Entorno de ejecución
NODE_ENV=production
PORT=10000

# ======================================
# BASE DE DATOS MYSQL (PRODUCCIÓN)
# ======================================
# Tu base de datos en Clever Cloud - Configura estas variables en Render:

DATABASE_HOST=bmxmxtdp6u4aorkf4h9y-mysql.services.clever-cloud.com
DATABASE_PORT=3306
DATABASE_USER=udw12ldxhzrkmvz5
DATABASE_PASSWORD=mh2lXow9rpQ2VavbhMul
